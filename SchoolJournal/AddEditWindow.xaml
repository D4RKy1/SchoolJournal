<Window x:Class="SchoolJournal.AddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить/Редактировать" Height="300" Width="300">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Имя:"/>
            <TextBox x:Name="txtFirstName" Margin="0,0,0,10"/>
            <TextBlock Text="Фамилия:"/>
            <TextBox x:Name="txtLastName" Margin="0,0,0,10"/>
            <TextBlock Text="Предмет:"/>
            <TextBox x:Name="txtCourse" Margin="0,0,0,10"/>
            <TextBlock Text="Оценка:"/>
            <TextBox x:Name="txtGrade" Margin="0,0,0,10"/>
            <TextBlock Text="Дата:"/>
            <DatePicker x:Name="dpDate"/>
            <Button Content="Сохранить" Margin="0,10,0,0" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>