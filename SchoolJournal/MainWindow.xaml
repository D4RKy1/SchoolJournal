<Window x:Class="SchoolJournal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Электронный журнал" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="dgJournal" AutoGenerateColumns="False" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="GradeID" Binding="{Binding GradeID}" Visibility="Hidden"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}"/>
                <DataGridTextColumn Header="Предмет" Binding="{Binding CourseName}"/>
                <DataGridTextColumn Header="Оценка" Binding="{Binding Grade}"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
            <Button Content="Добавить" Width="100" Margin="0,0,0,5" Click="AddButton_Click"/>
            <Button Content="Редактировать" Width="100" Margin="0,0,0,5" Click="EditButton_Click"/>
            <Button Content="Удалить" Width="100" Click="DeleteButton_Click"/>
        </StackPanel>
    </Grid>
</Window>